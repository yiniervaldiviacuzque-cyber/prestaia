def dashboard_data(db: Session):
    today = date.today()
    credits = list(db.scalars(select(Credito).where(Credito.estado.in_(["activo", "vencido"]))))
    clientes_count = db.scalar(select(func.count()).select_from(Cliente)) or 0
    overdue = db.scalar(select(func.count()).select_from(Cuota).where(Cuota.saldo_pendiente > 0, Cuota.fecha_vencimiento < today)) or 0
    installments = db.scalar(select(func.count()).select_from(Cuota)) or 0
    total = sum((c.monto for c in credits), Decimal(0))
    balance = sum((c.saldo_pendiente for c in credits), Decimal(0))
    alerts_count = db.scalar(select(func.count()).select_from(Alerta).where(Alerta.resuelta.is_(False))) or 0
    high = db.scalar(select(func.count(func.distinct(Prediccion.credito_id))).where(Prediccion.nivel_riesgo == "alto")) or 0
    payments = db.scalar(select(func.coalesce(func.sum(Pago.monto), 0))) or Decimal(0)
    return {"cartera_total": total, "creditos_activos": sum(c.estado == "activo" for c in credits), "creditos_vencidos": overdue, "saldo_pendiente": balance, "pagos_recibidos": payments, "clientes_registrados": clientes_count, "porcentaje_morosidad": round(overdue / max(installments, 1) * 100, 2), "clientes_riesgo_alto": high, "alertas_activas": alerts_count}


