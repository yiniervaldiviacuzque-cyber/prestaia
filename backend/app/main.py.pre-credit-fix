database_url = settings.database_url
if database_url.startswith("postgresql://"):
    database_url = database_url.replace("postgresql://", "postgresql+psycopg://", 1)
engine = create_engine(database_url, pool_pre_ping=True) if database_url else None
SessionLocal = sessionmaker(bind=engine, expire_on_commit=False) if engine else None


def db_session():
    if SessionLocal is None:
        raise HTTPException(503, "Base de datos no configurada. Configure DATABASE_URL.")
    session = SessionLocal()
    try:
        yield session
    finally:
        session.close()


async def current_user(authorization: Optional[str] = Header(default=None), db: Session = Depends(db_session)):
    if not authorization or not authorization.lower().startswith("bearer "):
        raise HTTPException(401, "Autenticación requerida")
    if not settings.supabase_url or not settings.supabase_anon_key:
        raise HTTPException(503, "Autenticación Supabase no configurada")
    token = authorization.split(" ", 1)[1]
    try:
        async with httpx.AsyncClient(timeout=8) as client:
            response = await client.get(f"{settings.supabase_url.rstrip('/')}/auth/v1/user", headers={"Authorization": f"Bearer {token}", "apikey": settings.supabase_anon_key})
        if response.status_code != 200:
            raise HTTPException(401, "Sesión inválida o expirada")
        user_id = UUID(response.json()["id"])
    except HTTPException:
        raise
    except httpx.TimeoutException:
        raise HTTPException(503, "Supabase Auth no respondió a tiempo")
    except httpx.RequestError:
        raise HTTPException(503, "No fue posible conectar con Supabase Auth")
    except (ValueError, KeyError, TypeError):
        raise HTTPException(401, "Supabase devolvió una sesión inválida")
    profile = db.get(Perfil, user_id)
    if not profile or not profile.activo:
        raise HTTPException(403, "Perfil sin acceso activo")
    return {"id": user_id, "rol": profile.rol}


def require_roles(*roles):
    async def checker(user=Depends(current_user)):
        if user["rol"] not in roles:
            raise HTTPException(403, "Permisos insuficientes")
        return user
    return checker


class ClienteIn(BaseModel):
    codigo: str = Field(min_length=2, max_length=30)
    tipo_documento: str = Field(min_length=2, max_length=30)
    numero_documento: str = Field(min_length=3, max_length=40)
    nombres: str = Field(min_length=1, max_length=100)
    apellidos: str = Field(min_length=1, max_length=100)
    telefono: Optional[str] = Field(default=None, max_length=30)
    correo: Optional[str] = Field(default=None, max_length=254)
    direccion: Optional[str] = None
    ingresos_mensuales: Optional[Decimal] = Field(default=None, ge=0)
    activo: bool = True

    @field_validator("telefono", "correo", "direccion", "ingresos_mensuales", mode="before")
    @classmethod
    def normalizar_campos_opcionales(cls, value):
        if value is None:
            return None
        if isinstance(value, str):
            value = value.strip()
            if not value:
                return None
        return value

    @field_validator("correo")
    @classmethod
    def correo_valido(cls, value):
        if value is not None and ("@" not in value or "." not in value.rsplit("@", 1)[-1]):
            raise ValueError("Correo electrónico no válido")
        return value

    @field_validator("telefono")
    @classmethod
    def telefono_valido(cls, value):
        if value is not None:
            digits = sum(ch.isdigit() for ch in value)
            if digits < 6 or digits > 15 or any(not (ch.isdigit() or ch in "+-() ") for ch in value):
                raise ValueError("Teléfono no válido")
        return value


class CreditoIn(BaseModel):
    codigo: str = Field(min_length=2, max_length=30)
    cliente_id: UUID
    monto: Decimal = Field(gt=0, le=Decimal("100000000"))
    tasa_interes: Decimal = Field(ge=0, le=100)
    plazo_meses: int = Field(ge=1, le=600)
    frecuencia_pago: str = Field(default="mensual", pattern="^(semanal|quincenal|mensual)$")
    fecha_desembolso: date
    fecha_vencimiento: date
    saldo_pendiente: Optional[Decimal] = Field(default=None, ge=0)
    estado: EstadoCredito = EstadoCredito.activo

    @field_validator("fecha_vencimiento")
    @classmethod
    def fechas_validas(cls, value, info):
        desembolso = info.data.get("fecha_desembolso")
        if desembolso and value <= desembolso:
            raise ValueError("El vencimiento debe ser posterior al desembolso")
        return value


