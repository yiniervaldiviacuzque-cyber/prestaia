@app.post("/api/pagos", status_code=201)
def register_payment(payload: PagoIn, db: Session = Depends(db_session), user=Depends(require_roles("administrador", "cobranzas"))):
    cuota = db.scalar(select(Cuota).where(Cuota.id == payload.cuota_id).with_for_update())
    if not cuota: raise HTTPException(404, "Cuota no encontrada")
    if payload.monto > cuota.saldo_pendiente: raise HTTPException(422, "El pago supera el saldo de la cuota")
    if payload.referencia and db.scalar(select(Pago.id).where(Pago.cuota_id == cuota.id, Pago.referencia == payload.referencia)):
        raise HTTPException(409, "Ya existe un pago con esa referencia para esta cuota")
    pago = Pago(cuota_id=cuota.id, monto=payload.monto, referencia=payload.referencia)
    db.add(pago)
    cuota.saldo_pendiente -= payload.monto
    cuota.estado = "pagada" if cuota.saldo_pendiente == 0 else "parcial"
    credito = db.scalar(select(Credito).where(Credito.id == cuota.credito_id).with_for_update())
    credito.saldo_pendiente = max(Decimal(0), credito.saldo_pendiente - payload.monto)
    if credito.saldo_pendiente == 0: credito.estado = "pagado"
    db.commit(); db.refresh(pago)
    return {"id": str(pago.id), "cuota_id": str(cuota.id), "saldo_cuota": cuota.saldo_pendiente, "saldo_credito": credito.saldo_pendiente}


