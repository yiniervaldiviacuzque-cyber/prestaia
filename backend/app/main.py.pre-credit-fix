@app.post("/api/creditos", status_code=201)
def create_credit(payload: CreditoIn, db: Session = Depends(db_session), user=Depends(require_roles("administrador", "analista"))):
    if not db.get(Cliente, payload.cliente_id): raise HTTPException(404, "Cliente no encontrado")
    data = payload.model_dump(); data["saldo_pendiente"] = data["monto"] if data["saldo_pendiente"] is None else data["saldo_pendiente"]
    if data["saldo_pendiente"] > data["monto"]: raise HTTPException(422, "El saldo no puede superar el monto del crédito")
    obj = Credito(**data); db.add(obj)
    try: db.flush()
    except Exception: db.rollback(); raise HTTPException(409, "Código de crédito duplicado")
    # plazo_meses determina el plazo contractual; la frecuencia define cuántas cuotas caben.
    period_days = {"semanal": 7, "quincenal": 15, "mensual": 30}[obj.frecuencia_pago]
    duration_days = max((obj.fecha_vencimiento - obj.fecha_desembolso).days, 1)
    elapsed_count = max(1, (duration_days + period_days - 1) // period_days)
    planned_count = {"mensual": obj.plazo_meses, "quincenal": obj.plazo_meses * 2,
                     "semanal": max(1, (obj.plazo_meses * 365 + 83) // 84)}[obj.frecuencia_pago]
    count = min(elapsed_count, planned_count)
    total_due = (obj.monto * (Decimal(1) + obj.tasa_interes / 100 * Decimal(obj.plazo_meses) / 12)).quantize(Decimal("0.01"))
    amount = (total_due / count).quantize(Decimal("0.01"))
    remainder = total_due - amount * (count - 1)
    for n in range(1, count + 1):
        due = obj.fecha_vencimiento if n == count else min(obj.fecha_desembolso + timedelta(days=period_days * n), obj.fecha_vencimiento)
        installment = remainder if n == count else amount
        db.add(Cuota(credito_id=obj.id, numero=n, fecha_vencimiento=due, monto=installment, saldo_pendiente=installment))
    try:
        db.commit()
    except Exception:
        db.rollback()
        raise HTTPException(409, "No se pudo registrar el crédito y su cronograma")
    db.refresh(obj)
    return {"id": str(obj.id), "codigo": obj.codigo, "cuotas": count}


