@app.post("/api/clientes", status_code=201)
def create_client(payload: ClienteIn, db: Session = Depends(db_session), user=Depends(require_roles("administrador", "analista"))):
    from sqlalchemy.exc import IntegrityError

    data = payload.model_dump()
    data["codigo"] = data["codigo"].strip()
    data["tipo_documento"] = data["tipo_documento"].strip().upper()
    data["numero_documento"] = data["numero_documento"].strip().upper()
    data["nombres"] = data["nombres"].strip()
    data["apellidos"] = data["apellidos"].strip()

    if not data["codigo"] or not data["numero_documento"] or not data["nombres"] or not data["apellidos"]:
        raise HTTPException(422, "Complete los campos obligatorios del cliente")

    existing_code = db.scalar(
        select(Cliente.id).where(Cliente.codigo == data["codigo"]).limit(1)
    )
    if existing_code:
        raise HTTPException(409, f"El código {data['codigo']} ya está registrado")

    existing_document = db.scalar(
        select(Cliente.id).where(
            Cliente.tipo_documento == data["tipo_documento"],
            Cliente.numero_documento == data["numero_documento"]
        ).limit(1)
    )
    if existing_document:
        raise HTTPException(
            409,
            f"El documento {data['numero_documento']} ya está registrado para ese tipo de documento"
        )

    obj = Cliente(**data)
    db.add(obj)

    try:
        db.commit()
    except IntegrityError as exc:
        db.rollback()
        constraint = getattr(getattr(exc.orig, "diag", None), "constraint_name", None)

        if constraint == "uq_cliente_documento":
            raise HTTPException(409, "Este documento ya está registrado") from exc

        if constraint in ("clientes_codigo_key", "uq_clientes_codigo"):
            raise HTTPException(409, "Este código de cliente ya está registrado") from exc

        raise HTTPException(409, "No se pudo guardar el cliente por una restricción de la base de datos") from exc

    db.refresh(obj)
    return {"id": str(obj.id), "codigo": obj.codigo}


