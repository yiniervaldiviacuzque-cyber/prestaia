@app.post("/api/predicciones/evaluar", status_code=201)
def evaluate(credito_id: UUID, db: Session = Depends(db_session), user=Depends(require_roles("administrador", "analista"))):
    c = db.get(Credito, credito_id)
    if not c: raise HTTPException(404, "Crédito no encontrado")
    today = date.today(); cuotas = list(c.cuotas)
    late = [q for q in cuotas if q.saldo_pendiente > 0 and q.fecha_vencimiento < today]
    max_days = max(((today - q.fecha_vencimiento).days for q in late), default=0)
    pending = sum((q.saldo_pendiente for q in cuotas), Decimal(0))
    factors=[]; score=Decimal("0.05")
    if late:
        factors.append(f"{len(late)} cuota(s) con saldo vencido"); score += min(Decimal("0.5"), Decimal(max_days) / 180)
    if c.cliente.ingresos_mensuales and c.cliente.ingresos_mensuales > 0:
        ratio = c.saldo_pendiente / (c.cliente.ingresos_mensuales * 12)
        if ratio > Decimal("0.4"):
            factors.append("Saldo superior al 40% del ingreso anual registrado"); score += min(Decimal("0.35"), ratio / 2)
    else: factors.append("Ingresos del cliente no registrados; evaluación limitada")
    if not factors: factors.append("Sin cuotas vencidas; evaluación basada en información disponible")
    probability = min(Decimal("0.95"), score).quantize(Decimal("0.0001")); risk = "alto" if probability >= Decimal("0.5") else "medio" if probability >= Decimal("0.2") else "bajo"
    recommendation = "Contactar al cliente y acordar seguimiento prioritario" if risk == "alto" else "Revisar cumplimiento de cuotas en el próximo ciclo" if risk == "medio" else "Mantener seguimiento regular"
    if not cuotas:
        raise HTTPException(422, "No hay cronograma de cuotas; no existen datos suficientes para evaluar este crédito")
    import json
    p = Prediccion(credito_id=c.id, probabilidad_morosidad=probability, nivel_riesgo=risk, factores=json.dumps(factors, ensure_ascii=False), recomendacion=recommendation)
    db.add(p); db.commit(); db.refresh(p)
    return {"id": str(p.id), "credito_id": str(c.id), "probabilidad_morosidad": probability, "nivel_riesgo": risk, "metodo": p.metodo, "factores": factors, "recomendacion": recommendation, "nota": "Evaluación preliminar basada en reglas explícitas; no es un modelo entrenado ni una decisión automática."}


